# --- Green API (WhatsApp) ---
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=

# --- Text engine provider: 'openai' (default) or 'anthropic' ---
# Switch the brain between OpenAI and Claude. Images always use OpenAI.
TEXT_PROVIDER=openai

# --- Anthropic (Claude) - only needed if TEXT_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# --- BytePlus (Seedance video) ---
BYTEPLUS_API_KEY=
# Region endpoint for BytePlus ModelArk (Ark). Default is the AP-Southeast host.
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=seedance-1-0-lite-t2v-250428

# --- OpenAI (all images: conversational + content packs, via the Responses API) ---
OPENAI_API_KEY=
# Use EXPLICIT model ids from /v1/models (bare aliases like 'gpt-5.6' are
# unlisted and showed flaky routing). Tiers:
#   TEXT    = main content (chat, posts, hooks)      -> Terra
#   BULK    = variations at volume (content packs)   -> Luna
#   PREMIUM = automatic fallback when TEXT/BULK fail -> Sol
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_BULK_MODEL=gpt-5.6-luna
OPENAI_PREMIUM_MODEL=gpt-5.6-sol
# Model for the Responses API (editable multi-turn images).
OPENAI_RESPONSES_MODEL=gpt-5.6-terra

# --- Behavior ---
# Timezone for monthly quota boundaries (usage table).
TZ_NAME=Asia/Jerusalem
# Logging: debug | info | warn | error. Files land in <DATA_DIR>/logs/aura-YYYY-MM-DD.log
LOG_LEVEL=info
LOG_KEEP_DAYS=14

# --- Admin panel ---
ADMIN_PORT=3000
# Password to open the admin UI.
# PRODUCTION: run `npm run hash-password -- "your-password"` and set ADMIN_PASSWORD_HASH
# instead of the plaintext line below (then delete ADMIN_PASSWORD).
ADMIN_PASSWORD=change-me
ADMIN_PASSWORD_HASH=
# Secret for signing login sessions. Generate a long random string.
# If unset, sessions reset on every restart.
SESSION_SECRET=
# Force the Secure flag on the session cookie (set true if behind HTTPS and the
# proxy header isn't detected). On Railway HTTPS is automatic.
FORCE_SECURE_COOKIE=false

# --- Support contact ---
# Email shown to clients whose subscription is suspended or canceled.
SUPPORT_EMAIL=

# --- Storage ---
# Directory for the SQLite DB. On Railway, point this at a mounted Volume (e.g. /data).
DATA_DIR=

# --- Scheduled subscription content (daily stories/carousels/reels) ---
# MASTER SWITCH. Default OFF. The scheduler enqueues/sends nothing unless this is
# 'true' AND the service isn't paused in the admin panel AND the individual client
# has scheduled_content_enabled=true (which itself defaults to false).
SCHEDULED_CONTENT_ENABLED=false

# Daily send time + timezone defaults (per-client values override these).
# 24-hour HH:MM. A 12-hour value like '10:09PM' is rejected and falls back here.
DEFAULT_SEND_TIME=07:30
# (TZ_NAME above is reused as the default client timezone.)

# Recovery is bounded by the local DAY: an outage that ends at 13:00 still delivers
# a 09:00 client's content, because they paid for it. Once the date rolls over the
# day is credited back to the quota instead (the client is told why).
#
# What each client receives on each weekday is per-client, edited in the admin
# panel, and capped by the package allowance (WEEKLY_ALLOWANCE in src/config.js).

# Scheduler tick (ms, clamped to <= 60000 so it runs at least once per minute).
SCHEDULER_TICK_MS=30000

# Per-type worker concurrency. Video (reel) is slow/expensive, so keep it low.
CONCURRENCY_STORY=3
CONCURRENCY_CAROUSEL=2
CONCURRENCY_REEL=1
# Global cap on simultaneous WhatsApp sends (Green API).
CONCURRENCY_WHATSAPP=2

# Provider-specific DAILY safety caps (per UTC day). When a cap is reached, jobs
# stay queued (nothing deleted, no quota consumed) and resume the next day.
MAX_STORY_PER_DAY=200
MAX_CAROUSEL_PER_DAY=50
MAX_REEL_PER_DAY=20
MAX_WHATSAPP_PER_DAY=1000

# Delivery-job reliability.
JOB_MAX_RETRIES=4
JOB_BACKOFF_BASE_MS=30000
JOB_BACKOFF_CAP_MS=900000
JOB_LEASE_MS=600000
JOB_ITEM_TIMEOUT_MS=300000
